{
  "expo": {
    "name": "WuTao-App",
    "slug": "WuTao-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wutaoapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "cc.wutao.app",
      "backgroundColor": "#f5f7fa",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#303133",
          "defaultChannel": "review"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
