# MySQL配置
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Redis配置 (可选，默认无需密码)
# REDIS_PASSWORD=your_redis_password

# 时区
TZ=Asia/Shanghai

# ============================================
# 后端应用配置 (必须修改)
# ============================================

# JWT密钥 (必须修改! 使用随机字符串，至少32位)
JWT_SECRET_KEY=

# JWT过期时间(毫秒)，默认24小时
# JWT_TTL=86400000

# ============================================
# 阿里云OSS配置 (必须修改)
# ============================================
# OSS地域节点，如: oss-cn-shanghai.aliyuncs.com
ALIOSS_ENDPOINT=your-oss-endpoint-here
# OSS AccessKey ID
ALIOSS_ACCESS_KEY_ID=
# OSS AccessKey Secret
ALIOSS_ACCESS_KEY_SECRET=
# OSS Bucket 名称
ALIOSS_BUCKET_NAME=your-bucket-name

# ============================================
# 邮件配置 (必须修改)
# ============================================
# SMTP服务器地址
MAIL_HOST=smtp.qq.com
# SMTP服务器端口
MAIL_PORT=587
# 邮箱账号
MAIL_USERNAME=your-email@example.com
# 邮箱授权码
MAIL_PASSWORD=

# 发送者昵称
EMAIL_PERSONAL=YourName
# 发送者邮箱 (与 MAIL_USERNAME 保持一致)
EMAIL_FROM=your-email@example.com
# 访客登录验证码 (管理员知道即可)
VISITOR_VERIFY_CODE=

# ============================================
# AI 摘要模块 (可选，需以 AI_ENABLED=true 构建镜像才会打包该模块)
# ============================================
# 是否启用AI摘要模块 (true/false)
AI_ENABLED=false
# 模型接口地址 (OpenAI兼容协议，支持 DeepSeek/通义/智谱/OpenRouter 等)
AI_BASE_URL=https://api.deepseek.com/v1
# API秘钥
AI_API_KEY=
# 模型名称
AI_MODEL_NAME=deepseek-chat

# AI 封面生图（与摘要独立；平台待定，默认关闭）
# 兼容 images/generations 协议且返回 data[0].b64_json 的平台
AI_IMAGE_ENABLED=false
AI_IMAGE_ENDPOINT=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL_NAME=
AI_IMAGE_SIZE=1536x1024
# 仅在平台要求时填写 b64_json；不支持该参数时留空
AI_IMAGE_RESPONSE_FORMAT=
AI_IMAGE_TIMEOUT_SECONDS=180

# ============================================
# 网站URL配置
# ============================================
WEBSITE_TITLE=YourSiteTitle
WEBSITE_ADMIN=https://admin.example.com
WEBSITE_CV=https://cv.example.com
WEBSITE_BLOG=https://blog.example.com
